---
import { template } from '@/settings'

interface Props {
  gridTitle?: string;
  inline?: boolean;
  gridItems: {
    title: string;
    description: string;
    projectType?: string;
    link?: string
    pagePath?: string
  }[];
}

const {gridTitle, gridItems, inline = false} = Astro.props;
---
{gridTitle && <h2 class="text-3xl font-bold mb-8">{gridTitle}</h2>}
<div class={inline ? 'contents' : 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6'}>
  {gridItems.map((item) => (
    <div class="p-6 rounded-lg text-base-content bg-base-200">
      <h3 class="text-xl font-semibold mb-3">{item.title}</h3>
      {item.projectType && (
        <p class="text-sm text-base-content/70 mb-3">{item.projectType}</p>
      )}
      <p>{item.description}</p>
      {item.pagePath && (
        <a href={`${template.base}${item.pagePath}`} class="link link-primary mt-2 inline-block">
          En savoir plus
        </a>
      )}
      {item.link && !item.pagePath && (
        <a href={item.link} target="_blank" class="link link-primary mt-2 inline-block">
          Voir sur Github
        </a>
      )}
    </div>
  ))}
</div>
