---
const {fullName, title, institute, description} = Astro.props
---
<div class='flex-1'>
  <h1 class='text-4xl font-bold mb-4'>
    Bonjour ! Je suis <span class='text-primary'>{fullName}</span>
  </h1>
  <p class='text-xl text-gray-600 mb-4'>{title}{institute ? ` at ${institute}` : ''}</p>
  <p class='text-lg mb-6 whitespace-pre-line' set:html={description} />
</div>
