---
import Layout from "@/layouts/Layout.astro";
import { profile } from "@/settings";
import BetterIcon from "@/components/ui/BetterIcon.astro";
import List from "@/components/ui/List.astro";
import {RESEARCH_ICONS} from "@/data/researchIcons";

const { research_areas } = profile;
---

<Layout title="Projets | Nofy Leclercq">
  <div class="prose max-w-none">
    <h1 class="text-3xl font-bold mb-8">Projets réalisés à l'École 42</h1>

    <div class="mb-12">
      <p class="text-lg mb-6">
        Voici une sélection de projets réalisés au cours de mon cursus à l'École 42, choisis pour représenter les différents domaines que j'ai explorés, notamment le Web, l'IA et la Data.
      </p>
    </div>

    
    <div class="grid gap-8 mb-12">
      {
        research_areas.map((area) => (
          <div class="flex gap-6 items-start">
            <BetterIcon>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke-width="2"
                class="size-6 stroke-accent"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d={RESEARCH_ICONS[area.field as keyof typeof RESEARCH_ICONS]?.path || RESEARCH_ICONS['computer-science'].path}
                />
              </svg>
            </BetterIcon>
            <div>
              <h3 class="text-xl font-semibold mb-2">{area.title}</h3>
              <p class="text-base">{area.description}</p>
              {area.details && (
                <div class="text-base mt-2 text-gray-600 whitespace-pre-line" set:html={area.details} />
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Layout>
