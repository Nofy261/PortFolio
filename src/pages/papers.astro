---
import Layout from "@/layouts/Layout.astro";
import { publications } from "@/data/cv";
import { template } from "@/settings";

const ALL_PAPERS = publications;
---

<Layout title="Portfolio | Nofy Leclercq">
  <div class="prose max-w-none">
    <h1 class="text-3xl font-bold mb-8">Portfolio</h1>

    <div class="space-y-16">
      {
        ALL_PAPERS.map((paper) => (
          <div class="card bg-base-200">
            <div class="card-body">
              <h2 class="card-title text-2xl">{paper.title}</h2>
              <p class="text-lg text-base-content/70 mb-1">{paper.subtitle}</p>
              {paper.technologies?.length > 0 && (
                <p class="text-sm text-base-content/60 mb-4">
                  {paper.technologies.join(" · ")}
                </p>
              )}

              {paper.image && (
                <img src={`${template.base}/${paper.image}`} alt={paper.title} class="rounded-lg w-full max-h-96 object-cover object-top mb-6" />
              )}

              {paper.about && (
                <div class="mb-6">
                  <h3 class="text-lg font-semibold mb-2">À propos</h3>
                  <p class="text-base-content/80">{paper.about}</p>
                </div>
              )}

              {paper.demoVideo && (
                <div class="mb-6">
                  <h3 class="text-lg font-semibold mb-2">Démonstration</h3>
                  <video controls class="rounded-lg w-full">
                    <source src={`${template.base}/${paper.demoVideo}`} type="video/mp4" />
                  </video>
                </div>
              )}

              {paper.features?.length > 0 && (
                <div class="mb-6">
                  <h3 class="text-lg font-semibold mb-2">Fonctionnalités</h3>
                  <ul class="list-disc list-inside space-y-1 text-base-content/80">
                    {paper.features.map((feature) => (
                      <li>{feature}</li>
                    ))}
                  </ul>
                </div>
              )}

              {paper.technologies?.length > 0 && (
                <div class="mb-6">
                  <h3 class="text-lg font-semibold mb-2">Stack technique</h3>
                  <div class="flex flex-wrap gap-2 mb-3">
                    {paper.technologies.map((tech) => (
                      <span class="badge badge-lg badge-outline">{tech}</span>
                    ))}
                  </div>
                  {paper.architecture && (
                    <p class="text-sm text-base-content/60 italic">{paper.architecture}</p>
                  )}
                </div>
              )}

              {paper.experience && (
                <div class="mb-6">
                  <h3 class="text-lg font-semibold mb-2">Mon expérience</h3>
                  <p class="text-base-content/80">{paper.experience}</p>
                </div>
              )}

              <div class="card-actions justify-end mt-4">
                <a href={paper.link} target="_blank" class="btn btn-sm btn-secondary text-secondary-content">
                  Voir sur GitHub
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Layout>
