---
import Layout from '@/layouts/Layout.astro'
import { template } from '@/settings'
---

<Layout title="404 - Page introuvable">
  <div class="min-h-[70vh] flex flex-col items-center justify-center text-center">
    <h1 class="text-9xl font-black text-base-content mb-4">404</h1>
    <h2 class="text-4xl font-bold text-base-content mb-8">Page introuvable</h2>
    <div class="flex gap-4">
      <a
        href={`${template.base}/`}
        class="btn btn-primary text-primary-content"
      >
        Retour à l'accueil
      </a>
      <button
        class="btn btn-outline btn-accent"
        onclick="history.back()"
      >
        Page précédente
      </button>
    </div>
  </div>
</Layout>
