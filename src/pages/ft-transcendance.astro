---
import Layout from '@/layouts/Layout.astro'
import { profile } from '@/settings'

const project = profile.research_areas.find(project => project.title === 'Ft_transcendance')!
---

<Layout title={`${project.title} | Nofy Leclercq`} description={project.description}>
  <div class='prose max-w-none'>
    <h1 class='text-3xl font-bold mb-8'>{project.title}</h1>
    <div class='card bg-base-200'>
      <div class='card-body'>
        <p class='text-lg text-base-content/70 mb-4'>{project.description}</p>
        <div class='text-base whitespace-pre-line' set:html={project.details} />
      </div>
    </div>
  </div>
</Layout>
